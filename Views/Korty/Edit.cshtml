@model RezerwacjeKortow.Models.Kort

<h2 class="mb-4">Edytuj Kort</h2>
<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Nazwa" class="form-label fw-bold"></label>
                    <input asp-for="Nazwa" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Opis" class="form-label fw-bold"></label>
                    <input asp-for="Opis" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="CenaZaGodzine" class="form-label fw-bold"></label>
                    <input asp-for="CenaZaGodzine" class="form-control" type="number" step="0.01" />
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">Zapisz zmiany</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>