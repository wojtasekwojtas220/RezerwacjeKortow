@model IEnumerable<RezerwacjeKortow.Models.Kort>

<style>
    body {
        background: linear-gradient(rgba(18, 18, 18, 0.65), rgba(18, 18, 18, 0.95)), 
                    url('https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&q=80&w=2000') no-repeat center center fixed !important;
        background-size: cover !important;
    }
    
    .glass-card {
        background-color: rgba(30, 30, 30, 0.6) !important;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }
</style>

<div class="px-4 py-5 text-center mb-5 mt-4">
    <h1 class="display-4 fw-bold text-white mb-3">Witaj na Kortach Tenisowych</h1>
    <p class="fs-5 text-light opacity-75">Zarezerwuj swój wymarzony kort w kilku kliknięciach.</p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-lg rounded-4 position-relative glass-card">
                <a asp-controller="Home" asp-action="OpisKortow" 
                   class="position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center text-decoration-none rounded-circle text-light border border-secondary shadow-sm" 
                   style="width: 32px; height: 32px; font-weight: bold; transition: 0.2s; z-index: 2; background-color: rgba(0,0,0,0.5);" 
                   onmouseover="this.style.backgroundColor='#198754'" 
                   onmouseout="this.style.backgroundColor='rgba(0,0,0,0.5)'" 
                   title="Zobacz opis kortów">?</a>

                <div class="card-body text-center p-4 mt-2">
                    <h3 class="card-title fw-bold text-success mb-3">@item.Nazwa</h3>
                    <h5 class="text-light opacity-75 mb-3">Nawierzchnia: @item.Opis</h5>
                    <div class="display-6 fw-bold mb-4 text-white">@item.CenaZaGodzine <span class="fs-4 text-light opacity-50">PLN/h</span></div>
                    
                    <a asp-controller="Rezerwacje" asp-action="Create" asp-route-kortId="@item.Id" class="btn btn-success btn-lg w-100 shadow-sm">
                        Zarezerwuj Termin
                    </a>
                </div>
            </div>
        </div>
    }
</div>