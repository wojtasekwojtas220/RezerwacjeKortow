@model IEnumerable<RezerwacjeKortow.Models.Kort>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Zarządzanie Kortami</h2>
    <a asp-action="Create" class="btn btn-success">Dodaj nowy kort</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nazwa kortu</th>
            <th>Nawierzchnia</th>
            <th>Cena/h (PLN)</th>
            <th class="text-end">Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td class="fw-bold">@item.Nazwa</td>
                <td>@item.Opis</td>
                <td>@item.CenaZaGodzine</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>